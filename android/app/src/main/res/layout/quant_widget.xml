<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/quant_widget_bg">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="quant" android:textStyle="bold" android:textSize="16sp" android:maxLines="1"/>
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
<LinearLayout android:id="@+id/widget_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"/>
</LinearLayout>